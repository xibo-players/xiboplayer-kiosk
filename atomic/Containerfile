# Xiboplayer Kiosk — Atomic Bootable Image
#
# Minimal bootc-based image: fedora-bootc + gdm + gnome-kiosk + codecs + players.
# ~1.5 GB smaller than Silverblue-based image by starting from a minimal base.
#
# Build:  podman build -t ghcr.io/xibo-players/xiboplayer-kiosk:43 -f atomic/Containerfile .
# Update: bootc switch --transport registry ghcr.io/xibo-players/xiboplayer-kiosk:43
#
# Base: fedora-bootc (systemd + kernel + dnf, no desktop) — 1.0 GB compressed
# vs Silverblue (full GNOME desktop + apps) — 2.5 GB compressed

FROM quay.io/fedora/fedora-bootc:43

# Global dnf optimization: skip docs and weak deps (saves ~300-500 MB)
RUN echo -e "tsflags=nodocs\ninstall_weak_deps=False" >> /etc/dnf/dnf.conf

# RPM Fusion free + nonfree (retry on mirror timeout)
RUN dnf install -y \
    https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-43.noarch.rpm \
    https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-43.noarch.rpm && \
    dnf clean all || \
    (echo "Retrying with direct download mirror..." && \
     dnf install -y \
       https://download1.rpmfusion.org/free/fedora/rpmfusion-free-release-43.noarch.rpm \
       https://download1.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-43.noarch.rpm && \
     dnf clean all)

# Xiboplayer repos (adds keyd COPR + GPG key)
ARG RELEASE_VER=43-7
RUN dnf install -y \
    https://github.com/xibo-players/xibo-players.github.io/releases/download/v${RELEASE_VER}/xiboplayer-release-${RELEASE_VER}.fc43.noarch.rpm && \
    dnf clean all

# Display manager + kiosk compositor (minimal GNOME, no apps)
# First-boot config (WiFi/timezone/CMS) runs via zenity — NO gnome-control-center,
# NO libadwaita/python3-gobject. The zenity menu calls nmcli/timedatectl directly
# through validated doas helpers. Per user directive 2026-04-11: "avoid at all
# cost to use gnome-settings" — if this RUN ever reintroduces gnome-control-center,
# the build breaks and forces the maintainer to use the direct helper path.
RUN dnf install -y \
    gdm gnome-kiosk gnome-kiosk-script-session \
    && dnf clean all

# Full codec stack (ffmpeg + gstreamer from RPM Fusion)
RUN dnf install -y \
    ffmpeg ffmpeg-libs \
    gstreamer1-plugins-base gstreamer1-plugins-good \
    gstreamer1-plugins-bad-free gstreamer1-plugins-bad-freeworld \
    gstreamer1-plugins-ugly-free gstreamer1-plugins-ugly \
    gstreamer1-plugin-openh264 gstreamer1-plugin-libav \
    mesa-va-drivers mesa-dri-drivers libva \
    && dnf clean all

# GPU drivers — best-effort per architecture
RUN dnf install -y libva-intel-media-driver 2>/dev/null; \
    dnf install -y libva-nvidia-driver 2>/dev/null; \
    dnf clean all || true

# Hardware support + media player
# Install linux-firmware then trim to Intel/AMD/RPi only (saves ~400 MB)
RUN dnf install -y \
    NetworkManager-wifi linux-firmware wireguard-tools \
    vlc mpv \
    && dnf clean all \
    && cd /usr/lib/firmware \
    && find . -maxdepth 1 -type d \
       ! -name '.' ! -name 'i915' ! -name 'amdgpu' ! -name 'intel' \
       ! -name 'nvidia' ! -name 'brcm' ! -name 'iwlwifi' ! -name 'ath10k' \
       ! -name 'ath11k' ! -name 'mediatek' ! -name 'rtl_nic' ! -name 'rtlwifi' \
       ! -name 'rtw88' ! -name 'rtw89' ! -name 'qcom' \
       -exec rm -rf {} + 2>/dev/null || true

# Kiosk utilities
RUN dnf install -y \
    avahi nss-mdns keyd opendoas \
    zenity dunst unclutter \
    && dnf clean all

# Xiboplayer packages — arexibo excluded from default image (~150 MB qt6 pull).
# Still available via netinstall with xibo.profile=arexibo kernel param.
RUN dnf install -y \
    xiboplayer-kiosk xiboplayer-electron xiboplayer-chromium \
    && dnf clean all

# Kiosk configuration overlay
#
# Note: as of 0.4.21 (#69), the system-level power management config files —
# /etc/systemd/logind.conf.d/no-idle.conf (Layer 1),
# /usr/share/glib-2.0/schemas/90_xiboplayer-kiosk.gschema.override (Layer 2),
# /etc/dconf/profile/gdm + /etc/dconf/db/gdm.d/00-xiboplayer-kiosk +
# /etc/dconf/db/gdm.d/locks/00-xiboplayer-kiosk (Layer 4) — are all shipped
# by the xiboplayer-kiosk RPM installed in the dnf step above. The RPM's
# %post scriptlet runs glib-compile-schemas + dconf update to activate them.
# No manual COPY or RUN needed for those files here.
COPY mkosi-extra/etc/gdm/custom.conf /etc/gdm/custom.conf
COPY mkosi-extra/etc/doas.conf /etc/doas.conf
COPY mkosi-extra/etc/locale.conf /etc/locale.conf
COPY mkosi-extra/etc/systemd/system/xiboplayer-kiosk-firstboot.service /etc/systemd/system/xiboplayer-kiosk-firstboot.service

# Skip gnome-initial-setup completely — our wizard handles system config
COPY mkosi-extra/usr/share/gnome-initial-setup/vendor.conf /usr/share/gnome-initial-setup/vendor.conf
RUN ln -sf /dev/null /etc/systemd/system/systemd-firstboot.service && \
    ln -sf /dev/null /etc/systemd/system/gnome-initial-setup.service && \
    ln -sf /dev/null /etc/systemd/system/gnome-initial-setup-first-login.service

COPY mkosi-extra/usr/lib/systemd/system-preset/80-xiboplayer-kiosk.preset /usr/lib/systemd/system-preset/80-xiboplayer-kiosk.preset
COPY mkosi-extra/usr/lib/sysusers.d/xiboplayer-kiosk.conf /usr/lib/sysusers.d/xiboplayer-kiosk.conf
COPY mkosi-extra/usr/lib/tmpfiles.d/xiboplayer-kiosk.conf /usr/lib/tmpfiles.d/xiboplayer-kiosk.conf
COPY mkosi-extra/usr/local/bin/xiboplayer-kiosk-firstboot.sh /usr/local/bin/xiboplayer-kiosk-firstboot.sh
COPY mkosi-extra/usr/local/bin/xibo-reboot /usr/local/bin/xibo-reboot
COPY mkosi-extra/usr/local/bin/xibo-shutdown /usr/local/bin/xibo-shutdown
COPY mkosi-extra/var/lib/AccountsService/users/xibo /var/lib/AccountsService/users/xibo

# Permissions
RUN chmod 600 /etc/doas.conf && \
    chmod 755 /usr/local/bin/xiboplayer-kiosk-firstboot.sh \
              /usr/local/bin/xibo-reboot \
              /usr/local/bin/xibo-shutdown

# Enable services
RUN systemctl preset-all && \
    systemctl enable gdm.service avahi-daemon.service keyd.service && \
    systemctl set-default graphical.target

# Automatic updates via bootc
RUN systemctl enable bootc-fetch-apply-updates.timer || true

# Final size cleanup
RUN rm -rf /usr/share/man /usr/share/doc /usr/share/info /usr/share/gtk-doc \
    && rm -rf /var/cache/dnf /var/log/dnf* /var/log/hawkey* \
    && rm -rf /usr/share/help /usr/share/gnome/help \
    && find /usr/share/locale -mindepth 1 -maxdepth 1 \
       ! -name 'en*' ! -name 'ca*' ! -name 'es*' ! -name 'fr*' ! -name 'de*' \
       ! -name 'it*' ! -name 'pt*' ! -name 'locale.alias' \
       -exec rm -rf {} + 2>/dev/null || true \
    && find /usr/lib/firmware -maxdepth 1 -type f \
       ! -name '*.bin' \
       -exec rm -f {} + 2>/dev/null || true

# Finalize
RUN bootc container lint
