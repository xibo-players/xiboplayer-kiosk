#!/bin/bash
# Post-install: configure graphical boot for kiosk

# Set graphical target so GDM starts on boot
systemctl set-default graphical.target

# Enable required services
systemctl enable gdm.service avahi-daemon.service keyd.service

# Enable lingering for xibo user (loginctl won't work in chroot)
mkdir -p /var/lib/systemd/linger
touch /var/lib/systemd/linger/xibo

# Copy skel to xibo home (sysusers.d doesn't do this)
if [ -d /etc/skel/.local ] && [ -d /home/xibo ]; then
    cp -rn /etc/skel/. /home/xibo/
    chown -R xibo:xibo /home/xibo 2>/dev/null || true
fi

# Permissions
chmod 600 /etc/doas.conf 2>/dev/null || true
