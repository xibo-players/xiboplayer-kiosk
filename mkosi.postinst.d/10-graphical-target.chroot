#!/bin/bash
# Set graphical target so GDM starts on boot
systemctl set-default graphical.target

# Enable required services (preset may not run in mkosi)
systemctl enable gdm.service
systemctl enable avahi-daemon.service
systemctl enable keyd.service

# Enable lingering for xibo user so user services start at boot
loginctl enable-linger xibo 2>/dev/null || mkdir -p /var/lib/systemd/linger && touch /var/lib/systemd/linger/xibo

# Set permissions
chmod 600 /etc/doas.conf 2>/dev/null || true
chmod 755 /home/xibo/.local/bin/* 2>/dev/null || true
chown -R xibo:xibo /home/xibo
