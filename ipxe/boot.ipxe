#!ipxe
# xiboplayer kiosk - iPXE Network Boot
#
# Boot any machine from the network and install xiboplayer-kiosk.
# The two default players (Chromium + Electron) are baked into every
# install. Arexibo is a netinstall opt-in: edit the kernel line and
# replace `xibo.profile=chromium` with `xibo.profile=arexibo` — the
# kickstart %post pulls the arexibo package on demand.
#
# Supported xibo.* kernel params (preseed the first-boot zenity menu):
#   xibo.profile=chromium|electron|arexibo   # active player
#   xibo.config_url=https://.../setup.json   # Layer-1 JSON preseed fetch
#   xibo.cms_url=   xibo.cms_key=   xibo.display_name=
#   xibo.timezone=  xibo.locale=
#   xibo.wifi_ssid= xibo.wifi_psk=
#   xibo.ssh_pubkey=   # URL-encoded ed25519/rsa pubkey
# See README.md "MSP workflow" for the full list + security notes.
# Use Ctrl+R after boot to switch player anytime.

set menu-timeout 30000
set ks-base https://raw.githubusercontent.com/xibo-players/xiboplayer-kiosk/main/kickstart

# Auto-detect architecture
iseq ${buildarch} arm64 && set arch aarch64 || set arch x86_64
# Use HTTP mirror — iPXE BIOS builds have limited HTTPS/TLS support
# and Fedora's HTTPS redirector triggers "Operation not permitted"
set fedora-mirror http://download.fedoraproject.org/pub/fedora/linux/releases/43/Everything/${arch}/os
set kernel-url ${fedora-mirror}/images/pxeboot/vmlinuz
set initrd-url ${fedora-mirror}/images/pxeboot/initrd.img

# DHCP
isset ${ip} || dhcp || goto failed
echo IP: ${ip} / ${netmask} / Gateway: ${gateway} / DNS: ${dns}
echo

:menu
menu xiboplayer kiosk - select default player (Ctrl+R to switch anytime)
item chromium             Install xiboplayer-kiosk - Chromium (ERASES DISK)
item electron             Install xiboplayer-kiosk - Electron  (ERASES DISK)
choose --timeout ${menu-timeout} --default chromium selected || goto menu
goto ${selected}

:chromium
echo Installing xiboplayer kiosk (default: Chromium)...
kernel ${kernel-url} inst.stage2=${fedora-mirror} inst.ks=${ks-base}/xiboplayer-kiosk.ks xibo.profile=chromium rd.neednet=1 ip=dhcp
initrd ${initrd-url}
boot || goto failed

:electron
echo Installing xiboplayer kiosk (default: Electron)...
kernel ${kernel-url} inst.stage2=${fedora-mirror} inst.ks=${ks-base}/xiboplayer-kiosk.ks xibo.profile=electron rd.neednet=1 ip=dhcp
initrd ${initrd-url}
boot || goto failed

# Arexibo netinstall opt-in: bake a custom boot.ipxe with a :arexibo label
# containing `xibo.profile=arexibo`, or pass the param interactively via
# `kernel ... xibo.profile=arexibo` at the iPXE shell.

:failed
echo
echo Boot failed. Check network connection.
echo
prompt Press any key to return to menu...
goto menu
